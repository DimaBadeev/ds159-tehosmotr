# Локально (Docker: docker compose up -d)
DATABASE_URL="postgresql://ds159:ds159@localhost:5432/ds159?schema=public"

# На Render эти значения задаются в Environment, не в файле:
# DATABASE_URL — Internal Database URL из PostgreSQL
# NEXTAUTH_URL — https://ВАШ-СЕРВИС.onrender.com
NEXTAUTH_SECRET="replace-with-a-long-random-string-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"
